---
/**
 * Human landing at `/` — served by Astro, delivered by the Next middleware
 * rewrite to `public/index.html` AFTER all gates (see middleware.ts).
 *
 * Astro owns the document: head, CSS, fonts, static shell.
 * Exactly ONE React island owns the interactive tree.
 *
 * NOTE: `app/globals.css` (Tailwind v4 preflight + shadcn tokens) is
 * deliberately NOT imported here — the landing is a Bootstrap 3.4.1 document
 * matching the target pixel-for-pixel, and Tailwind's preflight would fight
 * Bootstrap's resets. Tailwind remains untouched for every other Next route.
 */
import "../styles/astro-font.css"
import SeoHead from "../components/seo-head.astro"
import { SeoJsonLd } from "@/components/seo-json-ld"
import LandingShell from "../components/landing-shell.tsx"
import LandingPage from "@/components/landing-page"

export const viewport = { width: "device-width", initialScale: 1 }

// The island has no server env at runtime; bake the flag in at build time.
const allowLocalTestingEnv = ["1", "true", "yes"].includes(
  (import.meta.env.ALLOW_LOCAL_TESTING ?? "").trim().toLowerCase(),
)
---

<!DOCTYPE html>
<html lang="en-US">
  <head>
    <SeoHead />
    <SeoJsonLd />
  </head>
  <body>
    <LandingShell client:only="react" allowLocalTestingEnv={allowLocalTestingEnv}>
      <!--
        Step 1 landing UI: the real components, no simplified re-implementation.
        client:only on the CHILD as well: slot children of an island are static
        HTML unless the child carries its own directive — without it the form
        would render but never hydrate (no onSubmit, no state, dead inputs).
      -->
      <LandingPage client:only="react" />
    </LandingShell>
    <script src="/_vercel/insights/script.js" is:inline defer></script>
  </body>
</html>
